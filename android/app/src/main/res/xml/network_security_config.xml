<?xml version="1.0" encoding="utf-8"?>
<!-- The app is offline by design; if it ever did reach for the network, it would never do so unencrypted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
